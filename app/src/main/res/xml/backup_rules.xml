<?xml version="1.0" encoding="utf-8"?>
<!--
  Aura Mobile Defense guarda evidencia forense (hallazgos, anomalías, reglas de firewall) en
  almacenamiento privado. `android:allowBackup` está en false, pero estas reglas existen como
  segunda barrera: si alguien lo vuelve a poner en true, nada sale del dispositivo.

  Ver: https://developer.android.com/guide/topics/data/autobackup
-->
<full-backup-content>
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="file" path="." />
    <exclude domain="external" path="." />
    <exclude domain="root" path="." />
</full-backup-content>
